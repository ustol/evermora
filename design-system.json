{
  "$schema": "https://aned.ai/schemas/design-system.json",
  "name": "Akornafa Design System",
  "status": "adopted-in-place",
  "componentsDir": "src/components",
  "uiComponentsDir": "src/components/ui",
  "docsRoute": "/design-system",
  "docsFile": "src/app/design-system/page.tsx",
  "tokens": {
    "css": "src/app/globals.css",
    "source": "src/config/design-system.ts"
  },
  "brand": {
    "read": "Warm modern editorial publication system for readers, preserving the dignified Akornafa memorial brand.",
    "palette": "warm-gold, obsidian, cream, parchment, cocoa",
    "typography": {
      "body": "Source Sans 3 via @fontsource/source-sans-3",
      "headings": "Source Serif 4 via @fontsource/source-serif-4"
    }
  }
}
