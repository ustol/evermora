{
  "headers": {
    "x-nextjs-stale-time": "300",
    "x-nextjs-prerender": "1",
    "x-next-cache-tags": "_N_T_/layout,_N_T_/dashboard/layout,_N_T_/dashboard/memorials/layout,_N_T_/dashboard/memorials/page,_N_T_/dashboard/memorials"
  },
  "segmentPaths": [
    "/_tree",
    "/_full",
    "/dashboard/memorials/__PAGE__",
    "/dashboard/memorials",
    "/dashboard",
    "/_index",
    "/_head"
  ]
}